#!/bin/bash
# Rofi menu to switch the active audio output (sink).
#
# Lists every place sound can go, switches to the chosen one, and moves
# anything already playing along with it.
#
# The laptop's built-in sound chip runs ONE output at a time: its analog
# speakers OR a single HDMI display, never both. So those are offered as
# fixed entries here; picking one switches the chip's profile first
# (keeping the analog mic), then makes it the default. An HDMI display
# (external monitor or projector, plugged straight in or through the
# dock) only appears while it is actually connected.
#
# The ThinkPad dock's USB audio and Bluetooth headphones are separate
# devices, always listed when present. For a Bluetooth sink it forces the
# A2DP (stereo music) profile, not the HSP/HFP headset mono profile.

BUILTIN_CARD="alsa_card.pci-0000_00_1f.3"
BUILTIN_SINK_PREFIX="alsa_output.pci-0000_00_1f.3."

current_sink=$(pactl get-default-sink)

menu=""
declare -A label_to_sink label_to_profile

add_entry() { # $1 label, $2 sink, $3 profile (empty = no profile switch)
    local label="$1" sink="$2" profile="$3" mark=" "
    [ "$sink" = "$current_sink" ] && mark="*"
    local key="$mark $label"
    label_to_sink["$key"]="$sink"
    label_to_profile["$key"]="$profile"
    menu+="$key"$'\n'
}

# Built-in chip: laptop speakers are always an option.
add_entry "Laptop speakers" "${BUILTIN_SINK_PREFIX}analog-stereo" \
          "output:analog-stereo+input:analog-stereo"

# Built-in chip: one entry per HDMI display that is currently plugged in.
while IFS=$'\x01' read -r suffix hlabel; do
    [ -z "$suffix" ] && continue
    add_entry "$hlabel" "${BUILTIN_SINK_PREFIX}${suffix}" \
              "output:${suffix}+input:analog-stereo"
done < <(pactl list cards | awk -v RS="" -v FS="\n" -v card="$BUILTIN_CARD" '
    {
        iscard=0
        for (i=1;i<=NF;i++) if ($i ~ ("^[ \t]*Name:[ \t]*" card "$")) iscard=1
        if (!iscard) next
        for (i=1; i<=NF; i++) {
            if ($i ~ /^[ \t]+output:hdmi-stereo(-extra[0-9]+)?\+input:analog-stereo:/ && $i ~ /available: yes/) {
                l=$i; sub(/^[ \t]+/,"",l)
                prof=l; sub(/: .*/,"",prof)                             # output:hdmi-stereo-extra1+input:analog-stereo
                suf=prof; sub(/^output:/,"",suf); sub(/\+input:analog-stereo$/,"",suf)   # hdmi-stereo-extra1
                num=suf; sub(/^hdmi-stereo/,"",num); sub(/^-extra/,"",num)
                if (num=="") label="Projector / HDMI"; else label="Projector / HDMI " (num+1)
                print suf "\x01" label
            }
        }
        exit
    }')

# Other cards: dock USB audio, Bluetooth, anything else already exposed.
while IFS=$'\x01' read -r sink desc; do
    [ -z "$sink" ] && continue
    case "$sink" in
        ${BUILTIN_SINK_PREFIX}*) continue ;; # built-in handled above
    esac
    add_entry "$desc" "$sink" ""
done < <(pactl list sinks | awk -v RS="" -v FS="\n" '
{
    name=""; desc=""
    for (i=1; i<=NF; i++) {
        if ($i ~ /^[ \t]*Name:/)             { l=$i; sub(/^[ \t]*Name:[ \t]*/,"",l); name=l }
        else if ($i ~ /^[ \t]*Description:/) { l=$i; sub(/^[ \t]*Description:[ \t]*/,"",l); desc=l }
    }
    if (name == "") next
    print name "\x01" desc
}
')

chosen=$(printf '%s' "$menu" | rofi -dmenu -p "Output" -i)
[ -z "$chosen" ] && exit 0

sink=${label_to_sink[$chosen]}
profile=${label_to_profile[$chosen]}
[ -z "$sink" ] && exit 0

# Built-in entry: switch the chip's output profile first if it is not
# already there. The +input:analog-stereo half keeps the mic alive.
if [ -n "$profile" ]; then
    active=$(pactl list cards | awk -v RS="" -v FS="\n" -v card="$BUILTIN_CARD" '
        {
            iscard=0
            for (i=1;i<=NF;i++) if ($i ~ ("^[ \t]*Name:[ \t]*" card "$")) iscard=1
            if (!iscard) next
            for (i=1;i<=NF;i++) if ($i ~ /Active Profile:/) { l=$i; sub(/.*Active Profile:[ \t]*/,"",l); print l; exit }
        }')
    if [ "$active" != "$profile" ]; then
        pactl set-card-profile "$BUILTIN_CARD" "$profile"
        sleep 1
    fi
fi

# Bluetooth sink: make sure the card is on an A2DP profile, not headset mono.
if [[ "$sink" =~ ^bluez_output\.([^.]+)\. ]]; then
    card="bluez_card.${BASH_REMATCH[1]}"
    active=$(pactl list cards | awk -v RS="" -v FS="\n" -v target="$card" '
        { for (i=1;i<=NF;i++) if ($i ~ /^[ \t]*Name:[ \t]*'"$card"'$/) { found=1 }
          if (found) { for (i=1;i<=NF;i++) if ($i ~ /Active Profile:/) { l=$i; sub(/.*Active Profile:[ \t]*/,"",l); print l; exit } } }')
    if [[ "$active" != a2dp* ]]; then
        # Prefer AAC, fall back to the first available A2DP profile.
        profile=$(pactl list cards | awk -v RS="" -v FS="\n" -v card="$card" '
            {
                iscard=0
                for (i=1;i<=NF;i++) if ($i ~ ("^[ \t]*Name:[ \t]*" card "$")) iscard=1
                if (!iscard) next
                for (i=1;i<=NF;i++) {
                    if ($i ~ /^[ \t]+a2dp-sink.*available: yes/) {
                        l=$i; sub(/^[ \t]+/,"",l); sub(/:.*/,"",l)
                        if (l=="a2dp-sink") aac=l
                        else if (first=="") first=l
                    }
                }
                print (aac!="" ? aac : first); exit
            }')
        [ -n "$profile" ] && pactl set-card-profile "$card" "$profile" && sleep 1
    fi
fi

pactl set-default-sink "$sink"
pactl set-sink-mute "$sink" 0
for i in $(pactl list short sink-inputs | awk '{print $1}'); do
    pactl move-sink-input "$i" "$sink" 2>/dev/null
done
notify-send "Output" "Switched to ${chosen:2}"
