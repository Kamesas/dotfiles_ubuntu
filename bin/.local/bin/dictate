#!/bin/bash
# Push-to-talk dictation for any window. Hold Alt+R, speak, release — the
# speech is turned into text (offline) and typed into the focused window.
# State shows in waybar via the custom/dictate module, not in notifications;
# only failures produce a notification.
#
# Commands:
#   dictate start      — begin recording (key press)
#   dictate stop [uk]  — stop, transcribe, type (key release)
#   dictate [uk]       — toggle, kept for the waybar click
#
# Two engines, chosen by the key that stops the recording:
#   Alt+R        (no arg) — Parakeet: ~1 s, auto language, but mixes
#                Russian into Ukrainian speech.
#   Alt+Shift+R  ("uk")   — Whisper small pinned to Ukrainian: ~6 s,
#                clean Ukrainian.

WHISPER_DIR=~/.local/opt/whisper.cpp

ACTION="$1"
case "$ACTION" in
    start|stop) LANG_MODE="$2" ;;
    *) LANG_MODE="$ACTION"; ACTION=toggle ;;
esac

# Character counting and Cyrillic matching need a UTF-8 locale; sway may
# start the script without one.
export LC_ALL=C.UTF-8

PIDFILE="$XDG_RUNTIME_DIR/dictate.pid"
WAV="$XDG_RUNTIME_DIR/dictate.wav"
LOG="$XDG_RUNTIME_DIR/dictate.log"
STATE="$XDG_RUNTIME_DIR/dictate.state"

set_state() {  # rec | busy | "" (idle)
    if [ -n "$1" ]; then echo "$1" > "$STATE"; else rm -f "$STATE"; fi
    pkill -SIGRTMIN+10 waybar
}

# Recording active: stop the recorder and let the WAV file close cleanly.
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    [ "$ACTION" = start ] && exit 0
    kill -INT "$(cat "$PIDFILE")"
    rm -f "$PIDFILE"
    set_state busy
    sleep 0.3

    # Under half a second of audio is an accidental tap — drop it silently.
    if [ "$(stat -c%s "$WAV" 2>/dev/null || echo 0)" -lt 16000 ]; then
        rm -f "$WAV"
        set_state ""
        exit 0
    fi

    run_whisper() {  # $1 = language, $2 = model size
        "$WHISPER_DIR/build/bin/whisper-cli" -m "$WHISPER_DIR/models/ggml-$2.bin" \
            -f "$WAV" -l "$1" -np -nt -sns 2>/dev/null \
            | tr '\n' ' ' | sed 's/^ *//; s/ *$//'
    }

    # The active keyboard layout is a strong hint for the spoken language:
    # with a Ukrainian layout, skip the fast engine and pin Ukrainian.
    if [ -z "$LANG_MODE" ]; then
        swaymsg -t get_inputs | grep -q '"xkb_active_layout_name": "Ukrainian' && LANG_MODE=uk
    fi

    t0=$(date +%s%N)
    if [ "$LANG_MODE" = "uk" ]; then
        text=$(run_whisper uk small)
    else
        text=$("$WHISPER_DIR/build/bin/parakeet-cli" \
               -m "$WHISPER_DIR/models/ggml-parakeet-tdt-0.6b-v3-q8_0.bin" \
               -f "$WAV" -np 2>/dev/null \
               | tr '\n' ' ' | sed 's/^ *//; s/ *$//')
        # English layout but a mostly-Cyrillic result means the fast engine
        # wrote English speech in Ukrainian letters — redo pinned to English.
        # \p{Cyrillic}, not a [А-Я] range: GNU grep rejects letter ranges
        # under C.UTF-8 ("Invalid collation character") and would count 0.
        cyr=$(printf '%s' "$text" | grep -oP '\p{Cyrillic}' | wc -l)
        if [ "$cyr" -gt $(( ${#text} / 2 )) ]; then
            LANG_MODE="en-retry"
            text=$(run_whisper en base)
        fi
    fi
    t1=$(date +%s%N)
    # s16 mono 16 kHz WAV holds 32000 bytes per second of audio.
    audio_s=$(( $(stat -c%s "$WAV") / 32000 ))

    if [ -n "$text" ]; then
        rm -f "$WAV"
        # Safety net: apps sometimes swallow the simulated keystrokes, so
        # the text is always in the clipboard too — Ctrl+V recovers it.
        printf '%s' "$text" | wl-copy
        # WezTerm ignores Wayland virtual-keyboard input, so wtype can't
        # reach it — inject the text through wezterm's own CLI instead.
        focused=$(swaymsg -t get_tree | python3 -c "
import json, sys
def walk(n):
    if n.get('focused'):
        print(n.get('app_id') or n.get('window_properties', {}).get('class') or '')
        return True
    return any(walk(c) for c in n.get('nodes', []) + n.get('floating_nodes', []))
walk(json.load(sys.stdin))")
        if [[ "${focused,,}" == *wezterm* ]]; then
            # Outside a wezterm pane the CLI picks the mux socket and sees
            # no windows — point it at the GUI socket explicitly.
            export WEZTERM_UNIX_SOCKET=$(ls -t "$XDG_RUNTIME_DIR"/wezterm/gui-sock-* 2>/dev/null | head -1)
            pane=$(wezterm cli list-clients --format json 2>/dev/null \
                   | python3 -c "import json,sys; c=json.load(sys.stdin); print(c[0]['focused_pane_id'] if c else '')")
            method="wezterm-cli pane=$pane"
            if [ -n "$pane" ]; then
                printf '%s' "$text" | wezterm cli send-text --pane-id "$pane"
            else
                notify-send -u critical -t 4000 "Dictation" "Can't reach wezterm"
            fi
        elif [[ "${focused,,}" == *chrom* ]]; then
            # Chrome drops text typed through the virtual keyboard, but a
            # single paste shortcut gets through. The text is already in
            # the clipboard (safety-net copy above).
            method="paste"
            sleep 0.15
            wtype -M ctrl v -m ctrl
        else
            method="wtype"
            sleep 0.15
            wtype -d 12 -- "$text"
        fi
    else
        # Keep the audio of a failed run so the cause can be inspected.
        mv -f "$WAV" "$XDG_RUNTIME_DIR/dictate-failed.wav"
        notify-send -u critical -t 4000 "Dictation" "Heard nothing"
    fi
    set_state ""
    echo "$(date +%T) engine=${LANG_MODE:-auto} audio=${audio_s}s asr=$(( (t1-t0)/1000000 ))ms mic=$(pactl get-default-source) focused=$focused method=$method chars=${#text}" >> "$LOG"
    exit 0
fi

# Nothing is recording: a stray key release has nothing to do.
[ "$ACTION" = stop ] && exit 0

# Start recording. Refuse while the mic is muted — recording would only
# produce silence and a confusing "Heard nothing".
if [[ "$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)" == *MUTED* ]]; then
    notify-send -u critical -t 4000 "Dictation" "Mic is muted (Alt+M or click the bar icon)"
    exit 1
fi

rm -f "$WAV"
pw-record --format=s16 --rate=16000 --channels=1 "$WAV" > /dev/null 2>&1 &
rec_pid=$!
echo "$rec_pid" > "$PIDFILE"
set_state rec

# Watchdog: a recording running this long was forgotten. A push-to-talk
# hold (Alt+r) can miss its key release and stick — through kanata's
# tap-hold mods, Alt often lifts just before r, so Sway sees a plain r
# release, matches no binding, and the stop never runs. Hold mode gets a
# short limit so a stuck recording heals in seconds; the waybar-click
# toggle keeps a long limit because that mode is meant for long dictation.
# Either way the clip is dropped, not transcribed.
if [ "$ACTION" = start ]; then WATCHDOG=30; else WATCHDOG=180; fi
(
    sleep "$WATCHDOG"
    [ "$(cat "$PIDFILE" 2>/dev/null)" = "$rec_pid" ] || exit 0
    kill -INT "$rec_pid"
    rm -f "$PIDFILE"
    mv -f "$WAV" "$XDG_RUNTIME_DIR/dictate-failed.wav"
    set_state ""
    notify-send -u critical -t 6000 "Dictation" "Recording ran ${WATCHDOG}s — stopped, nothing typed. Audio kept at dictate-failed.wav"
    echo "$(date +%T) engine=watchdog audio=${WATCHDOG}s" >> "$LOG"
) &
