#!/bin/bash
# Suspend on idle, but only when running on battery. Called by swayidle's
# timeout command, which has no built-in way to check the power source.

# Gamepad input does not reset sway's idle timer, so a running emulator
# looks idle. Skip suspend while it is open.
if pgrep -x 'duckstation-qt|PPSSPPSDL|pcsx2(-qt)?' >/dev/null; then
    exit 0
fi

if [ "$(cat /sys/class/power_supply/AC/online)" = "0" ]; then
    systemctl suspend
fi
