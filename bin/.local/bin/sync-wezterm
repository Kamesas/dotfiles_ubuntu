#!/usr/bin/env bash
# The Windows WezTerm config lives on the Windows filesystem, outside this repo,
# because WezTerm reads it at launch and a symlink into WSL would break whenever
# the distro is not running. So it is a copy, and copies drift. This is how the
# drift gets noticed and closed.
#
#   sync-wezterm          show the difference, change nothing
#   sync-wezterm pull     Windows -> repo   (capture edits made on Windows)
#   sync-wezterm push     repo -> Windows   (apply edits made in the repo)
#
# The file branches on wezterm.target_triple, so one copy is correct for both
# Linux and Windows -- there is no per-platform version to keep apart.
set -euo pipefail

repo="$HOME/dotfiles/wezterm/.wezterm.lua"
win="/mnt/c/Users/alex/.wezterm.lua"

[ -f "$repo" ] || { echo "missing: $repo" >&2; exit 1; }
[ -f "$win" ]  || { echo "missing: $win (not on this machine?)" >&2; exit 1; }

case "${1:-diff}" in
  diff)
    if diff -q "$repo" "$win" >/dev/null; then
      echo "in sync"
    else
      echo "DIFFERENT  (repo <-> windows)"
      diff -u "$repo" "$win" || true
    fi
    ;;
  pull) cp "$win" "$repo"; echo "pulled Windows -> repo; commit it" ;;
  push) cp "$repo" "$win"; echo "pushed repo -> Windows; restart WezTerm" ;;
  *)    echo "usage: sync-wezterm [diff|pull|push]" >&2; exit 2 ;;
esac
