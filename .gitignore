# Backup directory
.dotfiles-backups/

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Temporary files
*.tmp
*.bak
*.backup
*.old

# Logs
*.log

# Lock files
*.lock
!lazy-lock.json

# OS generated files
.directory
desktop.ini

# SSH keys (safety measure)
**/.ssh/id_*
**/.ssh/*.pem
**/.ssh/*.key

# GPG keys
**/.gnupg/*.key
**/.gnupg/private-keys-v1.d/

# Sensitive data patterns
*password*
*secret*
*token*
*.env
.env.*

# Cache directories
__pycache__/
*.pyc
.cache/
cache/

# Node modules (if any)
node_modules/

# Neovim specific
nvim/.config/nvim/plugin/
nvim/.config/nvim/.netrwhist

# tmux plugins (managed by tpm)
tmux/.config/tmux/plugins/

# Fish shell
fish/.config/fish/fish_variables

# Application-specific caches
**/.config/*/Cache/
**/.config/*/cache/

# Stow can fold ~/.local into bin/.local when ~/.local does not exist yet. Then
# everything written to ~/.local lands in this repo: nvim plugins, the trash,
# zoxide's db, installed binaries. None of it belongs here.
bin/.local/share/
bin/.local/state/
bin/.local/bin/claude
bin/.local/bin/yazi
bin/.local/bin/ya
