# Sway config — T480
# Mod = Super (Win) key
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu rofi -show drun

# New windows open side by side instead of stacked top/bottom.
default_orientation horizontal

### Catppuccin Mocha colors
set $base   #1e1e2e
set $mantle #181825
set $text   #cdd6f4
set $blue   #89b4fa
set $blue_dim #546994
set $surface1 #45475a
set $red    #f38ba8

# Window colors:        border    background  text    indicator  child_border
client.focused          $blue_dim $base       $text   $blue_dim  $blue_dim
client.unfocused        $surface1 $base       $text   $surface1  $surface1
client.focused_inactive $surface1 $base       $text   $surface1  $surface1
client.urgent           $red      $base       $text   $red       $red

default_border pixel 2
default_floating_border pixel 2
gaps inner 6
# No outer gap: it also insets the workspace rect used for floating window
# percentage placement (e.g. the fullscreen dropdown terminals), regardless
# of smart_gaps, leaving them with an unwanted margin even when alone.
gaps outer 0
# Drop all gaps when a workspace has only one window; keep them when there are more.
smart_gaps on
# Hide the window border when gaps are off, so a single window is fully borderless.
smart_borders no_gaps

### Input
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
}

input type:keyboard {
    xkb_layout us,ua
}

### Output layout — external stacked above the laptop, laptop centered below.
# 320 = (2560 - 1920) / 2, so the narrower laptop sits centred under the wider
# external and the cursor crosses cleanly in the middle. External matched by
# make/model/serial so it survives different HDMI/DP ports.
output "Lenovo Group Limited R27qe UP3359FZ" position 0 0
output eDP-1 position 320 1440

### Autostart
exec wl-paste --watch cliphist store
exec blueman-applet
exec mako
exec /usr/libexec/polkit-mate-authentication-agent-1
# Auto-mount USB drives (Kindle etc.) to /run/media/alex/<label>
exec udiskie
exec awww-daemon
exec swayidle -w timeout 1200 ~/.local/bin/idle-suspend-on-battery
exec ~/.local/bin/display-guard
exec ~/.local/bin/battery-notify
# Renumber workspaces to close gaps when one empties (1,3 -> 1,2).
exec ~/.local/bin/ws-compact

### Keybindings — basics
# --to-code binds the physical key, so bindings work in any keyboard layout.
bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+c kill
bindsym --whole-window $mod+button2 kill
bindsym --to-code $mod+Shift+c reload
bindsym --to-code $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'
bindsym --to-code $mod+Shift+p exec wlogout
floating_modifier $mod normal

### Keybindings — custom (matches GNOME setup)
bindsym --to-code Alt+t exec ~/.local/bin/kitty-dropdown
bindsym --to-code Alt+w exec ~/.local/bin/wezterm-dropdown
bindsym --to-code Alt+u exec rofi -show drun
bindsym --to-code Alt+f exec ~/.local/bin/window-switch
bindsym --to-code Alt+n exec ~/.local/bin/wifi-menu
bindsym --to-code Alt+m exec ~/.local/bin/mic-menu
bindsym --to-code Alt+a exec ~/.local/bin/sink-menu
bindsym --to-code Alt+s exec ~/.local/bin/display-menu
bindsym --to-code Alt+b exec ~/.local/bin/battery-menu
bindsym --to-code Alt+d exec makoctl mode -t do-not-disturb && pkill -SIGRTMIN+8 waybar
bindsym --to-code Alt+p exec ~/.local/bin/clipboard-menu
bindsym --to-code Alt+o exec ~/.local/bin/wallpaper-menu
bindsym --to-code Alt+y exec ~/.local/bin/waybar-toggle
bindsym Print exec grim -g "$(slurp)" /tmp/screenshot.png && swappy -f /tmp/screenshot.png

### Keybindings — focus
bindsym --to-code $mod+Shift+h focus left
bindsym --to-code $mod+Shift+l focus right
bindsym --to-code $mod+Left focus left
bindsym --to-code $mod+Down focus down
bindsym --to-code $mod+Up focus up
bindsym --to-code $mod+Right focus right
bindsym --to-code $mod+Alt+h focus left
bindsym --to-code $mod+Alt+j focus down
bindsym --to-code $mod+Alt+k focus up
bindsym --to-code $mod+Alt+l focus right

### Keybindings — move window within workspace
bindsym --to-code $mod+Shift+Left move left
bindsym --to-code $mod+Shift+Down move down
bindsym --to-code $mod+Shift+Up move up
bindsym --to-code $mod+Shift+Right move right

### Keybindings — switch workspace (vim-style: h = prev, l = next)
# ws-relative steps by number and creates the next workspace on demand, so "next"
# past the last one opens a fresh one instead of wrapping (like GNOME).
bindsym --to-code $mod+h exec ~/.local/bin/ws-relative prev
bindsym --to-code $mod+l exec ~/.local/bin/ws-relative next

### Keybindings — move window to adjacent workspace and follow
bindsym --to-code $mod+j exec ~/.local/bin/ws-relative next move
bindsym --to-code $mod+k exec ~/.local/bin/ws-relative prev move

### Workspace-to-output assignment
# No pinning: one shared pool numbered from 1. A workspace opens on whatever
# screen is focused. This keeps numbering sane with any screen mix — desk
# monitor, projector, or laptop alone — instead of ranges leaking onto the
# wrong screen when a monitor is missing.

### Keybindings — workspaces
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+0 workspace number 10

bindsym --to-code Ctrl+Alt+1 move container to workspace number 1
bindsym --to-code Ctrl+Alt+2 move container to workspace number 2
bindsym --to-code Ctrl+Alt+3 move container to workspace number 3
bindsym --to-code Ctrl+Alt+4 move container to workspace number 4
bindsym --to-code Ctrl+Alt+5 move container to workspace number 5
bindsym --to-code Ctrl+Alt+6 move container to workspace number 6
bindsym --to-code Ctrl+Alt+7 move container to workspace number 7
bindsym --to-code Ctrl+Alt+8 move container to workspace number 8
bindsym --to-code Ctrl+Alt+9 move container to workspace number 9
bindsym --to-code Ctrl+Alt+0 move container to workspace number 10

### Keybindings — layout
bindsym --to-code $mod+b splith
bindsym --to-code $mod+v splitv
# Stacking/tabbed disabled — they draw container title bars (the H[app] line).
# Split layouts never show a title bar. Re-enable if you ever want tabs.
#bindsym $mod+s layout stacking
#bindsym $mod+w layout tabbed
bindsym --to-code $mod+e layout toggle split
bindsym --to-code $mod+f fullscreen
bindsym --to-code $mod+Shift+space floating toggle
bindsym --to-code $mod+a focus parent

### Keybindings — keyboard layout (matches GNOME's Win+Space)
bindsym --to-code $mod+space input "*" xkb_switch_layout next

### Keybindings — scratchpad
bindsym --to-code $mod+Shift+minus move scratchpad
bindsym --to-code $mod+minus scratchpad show

### Keybindings — resize mode
mode "resize" {
    bindsym --to-code $left resize shrink width 10px
    bindsym --to-code $down resize grow height 10px
    bindsym --to-code $up resize shrink height 10px
    bindsym --to-code $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym --to-code $mod+r mode "resize"

### Media / brightness keys
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle && pkill -SIGRTMIN+9 waybar
bindsym --locked XF86MonBrightnessDown exec ~/.local/bin/brightness-osd 5%-
bindsym --locked XF86MonBrightnessUp exec ~/.local/bin/brightness-osd 5%+

### Status bar
bar {
    swaybar_command waybar
}

include /etc/sway/config.d/*

for_window [app_id=".*"] border pixel 2
for_window [class=".*"] border pixel 2

# The projector clone window (wl-mirror) must never take focus when it
# appears — keystrokes would silently go to the projector's workspace.
no_focus [app_id="at.yrlf.wl_mirror"]

### Dropdown terminals — float, fill the workspace area (Waybar stays visible),
# and park in the scratchpad so Alt+t / Alt+w show/hide them from any workspace.
# They always cover the full screen alone, so drop the border like a single tiled window.
# No "scratchpad show" here: a new window starts small and would be visible while
# it grows to full size. Park it hidden; the dropdown script reveals it only after
# setting the final pixel size, so the first visible frame is already full-screen.
for_window [app_id="kitty-dropdown"] floating enable, border pixel 0, resize set width 100 ppt height 100 ppt, move position 0 ppt 0 ppt, move scratchpad
# WezTerm dropdown runs under XWayland (see wezterm-dropdown script), so it shows
# up as an X11 "class" rather than a native Wayland "app_id".
for_window [class="wezterm-dropdown"] floating enable, border pixel 0, resize set width 100 ppt height 100 ppt, move position 0 ppt 0 ppt, move scratchpad
